{
	"name": "Clube Alliance",
	"image": "mcr.microsoft.com/devcontainers/base:ubuntu",
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2": {}
	},
	"postCreateCommand": "bash scripts/setup.sh --demo",
	"forwardPorts": [8080, 8025],
	"portsAttributes": {
		"8080": { "label": "Site WordPress", "onAutoForward": "notify" },
		"8025": { "label": "E-mails de teste (Mailpit)", "onAutoForward": "silent" }
	},
	"hostRequirements": { "cpus": 2 },
	"customizations": {
		"vscode": {
			"extensions": ["bmewburn.vscode-intelephense-client"]
		}
	}
}
